# Server
PORT=3000
MCP_BEARER_TOKEN=change-me-to-a-long-random-string
DB_PATH=./data/nuvio-remit.db
TICKER_MS=15000

# Rates (Frankfurter, ECB mid-market; no key needed). ECB has no AED: AED/INR = USD/INR / 3.6725 (peg)
RATES_URL=https://api.frankfurter.dev/v1

# AWS / Bedrock (simulator only; never used inside tool handlers)
AWS_REGION=us-east-1
# Nova 2 Lite runs in us-east-1 only through the US inference profile (us. prefix).
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# AWS credentials come from the standard chain (env, profile, or instance role); do not put keys here.

# Simulator (/sim/*) and recording controls (/dev/*). Leave a code unset to disable that surface.
SIM_ACCESS_CODE=change-me-sim-code
DEV_CONTROLS_CODE=change-me-dev-code
SIM_DAILY_BEDROCK_CALLS=500
# Hosted demos: a page opened after this many quiet minutes, or on a new day, gets fresh demo data.
# 0 never reloads it (a local run keeps its ledger).
SIM_AUTO_RESET_MINUTES=0

# The assistant's voice (Amazon Polly, simulator only). POLLY_VOICE=none uses the browser's voice.
POLLY_VOICE=Kajal
POLLY_ENGINE=neural
SIM_DAILY_TTS_CHARS=100000

# Simulator mode. Unset: the live model when one is usable (AWS credentials for Bedrock, or an
# LLM_API_KEY), otherwise scripted (the demo script through the real tools, no model, no account).
# SIM_MODE=scripted
# The live model: bedrock (default) or openai_compatible (OpenAI, OpenRouter, Groq, Ollama, ...).
LLM_PROVIDER=bedrock
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-key
# LLM_MODEL=gpt-4o-mini
