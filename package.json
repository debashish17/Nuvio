{
  "name": "nuvio-remit",
  "version": "1.0.0",
  "private": true,
  "description": "Nuvio Remit: self-hosted MCP server for UAE to India remittances over a simulated ledger (Alexa+ hackathon)",
  "author": "debashish17",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "tsx scripts/build-ui.ts && tsx watch src/server/index.ts",
    "build": "tsx scripts/build-ui.ts && tsup",
    "build:ui": "tsx scripts/build-ui.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:serve": "tsx scripts/build-ui.ts && tsx src/db/cli.ts seed && tsx src/server/index.ts",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui",
    "format": "prettier --write .",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-polly": "^3.1156.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
